# Server
PORT=4000
NODE_ENV=development

# MongoDB (local example — replace with your MongoDB Atlas connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/bhanvi-solar

# JWT — generate strong random secrets for production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=

# Cloudinary — leave blank in local dev to fall back to local-disk image storage under /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Seed script (backend/src/database/seed.ts) — creates the initial admin user.
# If ADMIN_PASSWORD is omitted, a random password is generated and printed once.
ADMIN_NAME=Bhanvi Solar Admin
ADMIN_EMAIL=admin@bhanvisolar.example
ADMIN_PASSWORD=
